---
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>Dashboard | Amic</title>

    <style>
      :root {
        font-family:
          Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
          sans-serif;
        color: #0f172a;
        background: #f4f7fb;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
      }

      button {
        font: inherit;
      }

      .app {
        min-height: 100vh;
        padding: 24px;
      }

      .container {
        width: min(100%, 1050px);
        margin: 0 auto;
      }

      .header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 35px;
      }

      .brand {
        margin: 0;
        font-size: 35px;
        letter-spacing: -2px;
      }

      .logout {
        padding: 11px 18px;
        border: 1px solid #cbd5e1;
        border-radius: 12px;
        background: white;
        cursor: pointer;
        font-weight: 700;
      }

      .loading {
        min-height: 60vh;
        display: grid;
        place-items: center;
        color: #64748b;
        font-size: 18px;
      }

      .content {
        display: none;
      }

      .content.visible {
        display: block;
      }

      .welcome {
        margin-bottom: 25px;
      }

      .welcome h2 {
        margin: 0 0 7px;
        font-size: 29px;
      }

      .welcome p {
        margin: 0;
        color: #64748b;
      }

      .balance-card {
        padding: 34px;
        color: white;
        background:
          radial-gradient(
            circle at top right,
            rgba(96, 165, 250, 0.55),
            transparent 35%
          ),
          #111827;
        border-radius: 25px;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.2);
      }

      .balance-label {
        margin: 0 0 10px;
        color: #cbd5e1;
      }

      .balance {
        margin: 0;
        font-size: clamp(42px, 8vw, 70px);
        letter-spacing: -3px;
      }

      .demo {
        margin: 12px 0 0;
        color: #94a3b8;
        font-size: 14px;
      }

      .actions {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-top: 22px;
      }

      .action {
        padding: 25px;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
      }

      .action h3 {
        margin: 0 0 8px;
      }

      .action p {
        margin: 0;
        color: #64748b;
        line-height: 1.5;
      }

      @media (max-width: 700px) {
        .actions {
          grid-template-columns: 1fr;
        }

        .balance-card {
          padding: 26px;
        }
      }
    </style>
  </head>

  <body>
    <main class="app">
      <div class="container">
        <header class="header">
          <h1 class="brand">Amic</h1>

          <button id="logout-button" class="logout" type="button">
            Log out
          </button>
        </header>

        <div id="loading" class="loading">
          Checking your account...
        </div>

        <section id="content" class="content">
          <div class="welcome">
            <h2>Welcome</h2>

            <p id="user-email"></p>
          </div>

          <section class="balance-card">
            <p class="balance-label">Demo balance</p>
            <h2 class="balance">$10,000.00</h2>

            <p class="demo">
              This is demonstration money. It is not a real bank balance.
            </p>
          </section>

          <section class="actions">
            <article class="action">
              <h3>Add money</h3>
              <p>Payment deposits will be added later.</p>
            </article>

            <article class="action">
              <h3>Invest</h3>
              <p>Investment products will be added later.</p>
            </article>

            <article class="action">
              <h3>Crypto</h3>
              <p>Wallet connections will be added later.</p>
            </article>
          </section>
        </section>
      </div>
    </main>

    <script>
      import {
        onAuthStateChanged,
        signOut,
      } from "firebase/auth";

      import { auth } from "../firebase";

      const loading =
        document.querySelector<HTMLDivElement>("#loading");
      const content =
        document.querySelector<HTMLElement>("#content");
      const userEmail =
        document.querySelector<HTMLParagraphElement>("#user-email");
      const logoutButton =
        document.querySelector<HTMLButtonElement>("#logout-button");

      if (!loading || !content || !userEmail || !logoutButton) {
        throw new Error("Dashboard elements could not be found.");
      }

      onAuthStateChanged(auth, (user) => {
        if (!user) {
          window.location.replace("/login");
          return;
        }

        userEmail.textContent = user.email ?? "Signed-in user";
        loading.style.display = "none";
        content.classList.add("visible");
      });

      logoutButton.addEventListener("click", async () => {
        logoutButton.disabled = true;
        logoutButton.textContent = "Logging out...";

        try {
          await signOut(auth);
          window.location.replace("/login");
        } catch (error) {
          console.error("Logout failed:", error);

          logoutButton.disabled = false;
          logoutButton.textContent = "Log out";
        }
      });
    </script>
  </body>
</html>
