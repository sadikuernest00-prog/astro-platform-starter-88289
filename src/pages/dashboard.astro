---
let balance = 10000;
---

<html>
  <head>
    <title>Dashboard</title>
  </head>
  <body style="font-family: Arial; text-align: center; margin-top: 100px;">
    
    <h1>Dashboard</h1>
    <h2>Your Balance: ${balance}</h2>

    <input id="amount" type="number" placeholder="Enter amount" style="padding:10px;" />

    <br /><br />

    <button onclick="deposit()" style="padding:10px;">Deposit</button>
    <button onclick="withdraw()" style="padding:10px;">Withdraw</button>

    <script>
      let balance = 10000;

      function deposit() {
        let amount = document.getElementById("amount").value;
        balance += Number(amount);
        alert("New Balance: $" + balance);
      }

      function withdraw() {
        let amount = document.getElementById("amount").value;
        balance -= Number(amount);
        alert("New Balance: $" + balance);
      }
    </script>

  </body>
</html>
