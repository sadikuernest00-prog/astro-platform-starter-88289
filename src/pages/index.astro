---
const products = [
  {
    name: "Vitamin D3 + K2",
    description: "Et nøye sammensatt tilskudd for daglig støtte til immunforsvar og skjelett.",
    price: "249 kr"
  },
  {
    name: "Vitamin C 1000",
    description: "Et klassisk valg for deg som ønsker et enkelt og pålitelig daglig tilskudd.",
    price: "199 kr"
  },
  {
    name: "Magnesium Balance",
    description: "Utviklet for deg som ønsker støtte til restitusjon, ro og en balansert hverdag.",
    price: "239 kr"
  }
];

const values = [
  {
    title: "Kvalitet i sentrum",
    text: "Vi legger vekt på rene produkter, tydelig kommunikasjon og et gjennomført kvalitetsnivå."
  },
  {
    title: "Rolig og tydelig",
    text: "En enklere handleopplevelse med et språk og uttrykk som skaper tillit."
  },
  {
    title: "For moderne hverdager",
    text: "Produkter utviklet for mennesker som ønsker oversikt, balanse og gode rutiner."
  }
];

const testimonials = [
  {
    quote: "Elegant uttrykk, enkel bestilling og produkter som føles seriøse.",
    name: "Maria, Oslo"
  },
  {
    quote: "Et merke som fremstår rolig, rent og tillitsvekkende.",
    name: "Henrik, Bergen"
  },
  {
    quote: "Jeg liker at alt er enkelt å forstå, uten unødvendig støy.",
    name: "Silje, Trondheim"
  }
];
---

<html lang="no">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Amic Biotech | Eksklusive vitaminer for en balansert hverdag</title>
    <meta
      name="description"
      content="Amic Biotech tilbyr eksklusive vitaminer og kosttilskudd i et rent, nøytralt og tillitsvekkende norsk uttrykk."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Cormorant+Garamond:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --bg: #f5f3ef;
        --surface: #fbfaf8;
        --surface-strong: #f0ece6;
        --text: #1f1d1a;
        --muted: #6d675f;
        --line: #ddd5cb;
        --accent: #8a7560;
        --accent-dark: #6e5d4d;
        --white: #ffffff;
        --shadow: 0 18px 40px rgba(35, 28, 21, 0.06);
        --radius-lg: 28px;
        --radius-md: 18px;
        --container: 1180px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: "Inter", sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.65;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        max-width: 100%;
        display: block;
      }

      .container {
        width: min(100% - 32px, var(--container));
        margin: 0 auto;
      }

      .serif {
        font-family: "Cormorant Garamond", serif;
      }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: rgba(245, 243, 239, 0.9);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid rgba(221, 213, 203, 0.7);
      }

      .nav {
        min-height: 82px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 14px;
        font-weight: 600;
        letter-spacing: 0.02em;
      }

      .brand-mark {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, #b49b84, #8a7560);
        color: white;
        font-weight: 700;
      }

      .brand-text {
        display: flex;
        flex-direction: column;
        line-height: 1.1;
      }

      .brand-text small {
        color: var(--muted);
        font-size: 0.74rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .menu {
        display: flex;
        gap: 28px;
        color: var(--muted);
        font-size: 0.96rem;
      }

      .menu a:hover {
        color: var(--text);
      }

      .nav-cta {
        padding: 12px 20px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: var(--white);
        font-weight: 600;
      }

      .hero {
        padding: 92px 0 56px;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 44px;
        align-items: center;
      }

      .eyebrow {
        display: inline-block;
        font-size: 0.78rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--accent-dark);
        margin-bottom: 18px;
      }

      .hero h1 {
        margin: 0 0 18px;
        font-size: clamp(3rem, 6vw, 5.3rem);
        line-height: 0.95;
        font-weight: 600;
        letter-spacing: -0.02em;
      }

      .hero p {
        max-width: 620px;
        color: var(--muted);
        font-size: 1.08rem;
        margin: 0 0 28px;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-bottom: 28px;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 14px 22px;
        border-radius: 999px;
        font-weight: 600;
        transition: 0.2s ease;
      }

      .btn-primary {
        background: var(--text);
        color: white;
      }

      .btn-primary:hover {
        background: #000;
      }

      .btn-secondary {
        background: transparent;
        border: 1px solid var(--line);
        color: var(--text);
      }

      .hero-notes {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        color: var(--muted);
        font-size: 0.95rem;
      }

      .hero-card {
        background: linear-gradient(180deg, #f8f6f2, #efe8de);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        padding: 28px;
        box-shadow: var(--shadow);
      }

      .hero-visual {
        border-radius: 22px;
        background:
          linear-gradient(rgba(255,255,255,0.18), rgba(255,255,255,0.18)),
          radial-gradient(circle at top left, #f7efe4, transparent 45%),
          linear-gradient(135deg, #b8a28d, #7c6a5b);
        min-height: 520px;
        display: flex;
        align-items: flex-end;
        padding: 26px;
      }

      .hero-panel {
        width: 100%;
        background: rgba(255, 255, 255, 0.82);
        border: 1px solid rgba(255,255,255,0.7);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 22px;
      }

      .hero-panel small {
        display: block;
        color: var(--muted);
        margin-bottom: 8px;
      }

      .hero-panel h3 {
        margin: 0 0 8px;
        font-size: 1.4rem;
      }

      .hero-panel p {
        margin: 0 0 12px;
        color: var(--muted);
        font-size: 0.98rem;
      }

      .hero-panel strong {
        font-size: 1.2rem;
      }

      .strip {
        padding: 22px 0;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        background: rgba(255,255,255,0.5);
      }

      .strip-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        text-align: center;
        color: var(--muted);
        font-size: 0.95rem;
      }

      .section {
        padding: 96px 0;
      }

      .section-head {
        max-width: 760px;
        margin-bottom: 34px;
      }

      .section-head .eyebrow {
        margin-bottom: 10px;
      }

      .section-head h2 {
        margin: 0 0 12px;
        font-size: clamp(2.3rem, 5vw, 4rem);
        line-height: 1;
        font-weight: 600;
      }

      .section-head p {
        margin: 0;
        color: var(--muted);
        font-size: 1.02rem;
      }

      .products-grid,
      .values-grid,
      .quotes-grid,
      .contact-grid {
        display: grid;
        gap: 24px;
      }

      .products-grid {
        grid-template-columns: repeat(3, 1fr);
      }

      .product-card,
      .value-card,
      .quote-card,
      .contact-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow);
      }

      .product-card {
        overflow: hidden;
      }

      .product-visual {
        height: 240px;
        background:
          radial-gradient(circle at top left, rgba(255,255,255,0.7), transparent 35%),
          linear-gradient(135deg, #d5cabd, #b39e89 55%, #887665);
      }

      .product-body {
        padding: 24px;
      }

      .product-body h3 {
        margin: 0 0 10px;
        font-size: 1.25rem;
      }

      .product-body p {
        margin: 0 0 18px;
        color: var(--muted);
      }

      .product-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
      }

      .price {
        font-weight: 700;
        font-size: 1.05rem;
      }

      .buy-link {
        padding: 10px 16px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: white;
        font-weight: 600;
      }

      .values-grid,
      .quotes-grid,
      .contact-grid {
        grid-template-columns: repeat(3, 1fr);
      }

      .value-card,
      .quote-card,
      .contact-card {
        padding: 24px;
      }

      .value-card h3,
      .contact-card h3 {
        margin-top: 0;
        margin-bottom: 10px;
        font-size: 1.12rem;
      }

      .value-card p,
      .contact-card p,
      .quote-card p {
        margin: 0;
        color: var(--muted);
      }

      .quote-card strong {
        display: block;
        margin-top: 16px;
        font-size: 0.95rem;
      }

      .about {
        background: linear-gradient(180deg, rgba(255,255,255,0.32), rgba(255,255,255,0.08));
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .about-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 34px;
        align-items: center;
      }

      .about-box {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        padding: 34px;
        box-shadow: var(--shadow);
      }

      .about-box h3 {
        margin-top: 0;
        margin-bottom: 12px;
      }

      .about-box ul {
        margin: 0;
        padding-left: 18px;
        color: var(--muted);
      }

      .newsletter-wrap {
        background: #ede6dc;
        border: 1px solid var(--line);
        border-radius: 28px;
        padding: 38px;
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 28px;
        align-items: center;
      }

      .newsletter-wrap p {
        color: var(--muted);
        margin: 0;
      }

      .newsletter-form {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      .newsletter-form input {
        flex: 1;
        min-width: 220px;
        padding: 15px 18px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: white;
        font: inherit;
      }

      footer {
        padding-top: 62px;
        background: #ece6dd;
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        gap: 24px;
        padding-bottom: 28px;
      }

      footer h3,
      footer h4 {
        margin-top: 0;
        margin-bottom: 12px;
      }

      footer p,
      footer a {
        color: var(--muted);
      }

      footer a {
        display: block;
        margin-bottom: 8px;
      }

      .copyright {
        padding: 18px 0 28px;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 0.94rem;
      }

      @media (max-width: 980px) {
        .hero-grid,
        .about-grid,
        .newsletter-wrap,
        .products-grid,
        .values-grid,
        .quotes-grid,
        .contact-grid,
        .footer-grid,
        .strip-grid {
          grid-template-columns: 1fr;
        }

        .menu {
          display: none;
        }

        .hero {
          padding-top: 56px;
        }

        .hero-visual {
          min-height: 380px;
        }
      }

      @media (max-width: 640px) {
        .hero h1 {
          font-size: 2.8rem;
        }

        .hero-actions {
          flex-direction: column;
        }

        .btn,
        .nav-cta,
        .buy-link {
          width: 100%;
          text-align: center;
        }

        .newsletter-wrap,
        .about-box,
        .product-body,
        .value-card,
        .quote-card,
        .contact-card {
          padding: 22px;
        }
      }
    </style>
  </head>

  <body>
    <header class="topbar">
      <div class="container nav">
        <a href="/" class="brand">
          <span class="brand-mark">A</span>
          <span class="brand-text">
            <span>Amic Biotech</span>
            <small>Oslo • Norge</small>
          </span>
        </a>

        <nav class="menu">
          <a href="#produkter">Produkter</a>
          <a href="#om-oss">Om oss</a>
          <a href="#kvalitet">Kvalitet</a>
          <a href="#kontakt">Kontakt</a>
        </nav>

        <a href="#produkter" class="nav-cta">Utforsk sortimentet</a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container hero-grid">
          <div>
            <span class="eyebrow">Amic Biotech</span>
            <h1 class="serif">Vitaminer i et rolig, eksklusivt og moderne uttrykk.</h1>
            <p>
              Amic Biotech tilbyr nøye utvalgte vitaminer og kosttilskudd for deg som ønsker
              kvalitet, enkelhet og en mer bevisst hverdag. Et norsk uttrykk, et tydelig språk
              og et sortiment utviklet med omtanke.
            </p>

            <div class="hero-actions">
              <a href="#produkter" class="btn btn-primary">Se produkter</a>
              <a href="#om-oss" class="btn btn-secondary">Les om merkevaren</a>
            </div>

            <div class="hero-notes">
              <span>Diskré design</span>
              <span>Gjennomført kvalitet</span>
              <span>Norsk og tillitsvekkende</span>
            </div>
          </div>

          <div class="hero-card">
            <div class="hero-visual">
              <div class="hero-panel">
                <small>Utvalgt produkt</small>
                <h3>Vitamin D3 + K2</h3>
                <p>
                  Et daglig tilskudd utviklet for deg som ønsker et enkelt, gjennomført og
                  kvalitetsbevisst valg.
                </p>
                <strong>249 kr</strong>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="strip">
        <div class="container strip-grid">
          <div>Nøye utvalgt sortiment</div>
          <div>Ryddig norsk kundereise</div>
          <div>Et mer eksklusivt uttrykk</div>
        </div>
      </section>

      <section class="section" id="produkter">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Sortiment</span>
            <h2 class="serif">Utvalgte produkter</h2>
            <p>
              Et mindre og mer gjennomført utvalg for deg som ønsker kvalitet fremfor støy.
            </p>
          </div>

          <div class="products-grid">
            {products.map((product) => (
              <article class="product-card">
                <div class="product-visual"></div>
                <div class="product-body">
                  <h3>{product.name}</h3>
                  <p>{product.description}</p>
                  <div class="product-row">
                    <span class="price">{product.price}</span>
                    <a href="#kontakt" class="buy-link">Bestill</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="kvalitet">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Vår tilnærming</span>
            <h2 class="serif">Kvalitet uten støy</h2>
            <p>
              Vi ønsker at helsetilskudd skal oppleves ryddig, tillitsvekkende og enkelt å forstå.
            </p>
          </div>

          <div class="values-grid">
            {values.map((value) => (
              <article class="value-card">
                <h3>{value.title}</h3>
                <p>{value.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section about" id="om-oss">
        <div class="container about-grid">
          <div>
            <span class="eyebrow">Om Amic Biotech</span>
            <h2 class="serif">Et norsk uttrykk for moderne velvære.</h2>
            <p>
              Amic Biotech er utviklet for mennesker som ønsker et mer dempet, rent og eksklusivt
              alternativ innen vitaminer og kosttilskudd. Vi tror at kvalitet også handler om
              hvordan et produkt presenteres, forstås og oppleves.
            </p>
            <p>
              Derfor bygger vi et merke der tydelighet, estetikk og tillit får like stor plass som
              selve produktet.
            </p>
          </div>

          <div class="about-box">
            <h3>Dette skal kjennetegne oss</h3>
            <ul>
              <li>Rolig og nøytralt visuelt uttrykk</li>
              <li>Tydelig norsk språk</li>
              <li>Et premium preg uten å bli prangende</li>
              <li>En enklere og mer tillitsfull kundeopplevelse</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Tilbakemeldinger</span>
            <h2 class="serif">Et inntrykk som varer</h2>
            <p>
              Et eksklusivt uttrykk handler også om hvordan helheten oppleves av kunden.
            </p>
          </div>

          <div class="quotes-grid">
            {testimonials.map((item) => (
              <article class="quote-card">
                <p>“{item.quote}”</p>
                <strong>{item.name}</strong>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container newsletter-wrap">
          <div>
            <span class="eyebrow">Nyhetsbrev</span>
            <h2 class="serif" style="margin:0 0 10px;">Motta nyheter i et rolig tempo</h2>
            <p>
              Få oppdateringer om nye produkter, utvalgte lanseringer og inspirasjon fra Amic Biotech.
            </p>
          </div>

          <form class="newsletter-form">
            <input type="email" placeholder="Din e-postadresse" />
            <a href="#kontakt" class="btn btn-primary">Meld deg på</a>
          </form>
        </div>
      </section>

      <section class="section" id="kontakt">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Kontakt</span>
            <h2 class="serif">Vi hører gjerne fra deg</h2>
            <p>
              For spørsmål om produkter, samarbeid eller bestilling kan du kontakte oss direkte.
            </p>
          </div>

          <div class="contact-grid">
            <article class="contact-card">
              <h3>E-post</h3>
              <p>kontakt@amicbridge.com</p>
            </article>

            <article class="contact-card">
              <h3>Telefon</h3>
              <p>+47 00 00 00 00</p>
            </article>

            <article class="contact-card">
              <h3>Adresse</h3>
              <p>Oslo, Norge</p>
            </article>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-grid">
        <div>
          <h3>Amic Biotech</h3>
          <p>
            Eksklusive vitaminer og kosttilskudd i et rent, norsk og moderne uttrykk.
          </p>
        </div>

        <div>
          <h4>Navigasjon</h4>
          <a href="#produkter">Produkter</a>
          <a href="#om-oss">Om oss</a>
          <a href="#kontakt">Kontakt</a>
        </div>

        <div>
          <h4>Informasjon</h4>
          <a href="#">Kjøpsvilkår</a>
          <a href="#">Personvern</a>
          <a href="#">Levering</a>
        </div>
      </div>

      <div class="container copyright">
        © 2026 Amic Biotech. Alle rettigheter reservert.
      </div>
    </footer>
  </body>
</html>
