---
const products = [
  {
    name: "Vitamin D3 + K2",
    description: "Daglig støtte for immunforsvar, skjelett og generell balanse.",
    price: "249 kr",
    badge: "Bestselger",
    color: "linear-gradient(135deg, #3d9a61, #245d3e)"
  },
  {
    name: "Vitamin C 1000 mg",
    description: "Et klassisk valg for immunforsvar og antioksidantstøtte.",
    price: "199 kr",
    badge: "Populær",
    color: "linear-gradient(135deg, #ffb347, #f37f1f)"
  },
  {
    name: "Vitamin B12",
    description: "Passer for deg som ønsker energi og fokus i hverdagen.",
    price: "219 kr",
    badge: "Energi",
    color: "linear-gradient(135deg, #5ba8ff, #2b6ecb)"
  },
  {
    name: "Multivitamin Komplett",
    description: "En balansert miks av viktige vitaminer og mineraler.",
    price: "289 kr",
    badge: "Komplett",
    color: "linear-gradient(135deg, #ff8bb1, #df4c82)"
  },
  {
    name: "Magnesium Balance",
    description: "Støtte for muskler, restitusjon og ro i kroppen.",
    price: "239 kr",
    badge: "Restitusjon",
    color: "linear-gradient(135deg, #f2c94c, #d99b00)"
  },
  {
    name: "Omega 3 Premium",
    description: "Et godt tilskudd for hjerte, hjerne og generell helse.",
    price: "299 kr",
    badge: "Premium",
    color: "linear-gradient(135deg, #9b7bff, #6048bd)"
  }
];
---

<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Amic Biotech | Vitaminer for en bedre hverdag</title>
    <meta
      name="description"
      content="Amic Biotech tilbyr kvalitetsvitaminer og kosttilskudd for energi, immunforsvar og daglig velvære."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #f7faf7;
        --surface: #ffffff;
        --text: #1d2a22;
        --muted: #5d6b62;
        --primary: #2f7d4f;
        --primary-dark: #215c39;
        --accent: #dff3e6;
        --border: #e3ebe5;
        --shadow: 0 10px 30px rgba(20, 40, 25, 0.08);
        --radius: 18px;
        --container: 1180px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: "Inter", sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .container {
        width: min(100% - 32px, var(--container));
        margin: 0 auto;
      }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: rgba(247, 250, 247, 0.92);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--border);
      }

      .nav {
        min-height: 76px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 800;
        font-size: 1.05rem;
      }

      .logo-mark {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: var(--primary);
        color: white;
      }

      .menu {
        display: flex;
        gap: 24px;
        color: var(--muted);
      }

      .menu a:hover {
        color: var(--text);
      }

      .nav-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 18px;
        background: var(--text);
        color: white;
        border-radius: 999px;
        font-weight: 600;
      }

      .hero {
        padding: 88px 0 70px;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: 40px;
        align-items: center;
      }

      .badge,
      .section-tag,
      .pill {
        display: inline-block;
        padding: 8px 14px;
        background: var(--accent);
        color: var(--primary-dark);
        border-radius: 999px;
        font-size: 0.9rem;
        font-weight: 700;
      }

      .hero h1 {
        font-size: clamp(2.2rem, 5vw, 4.2rem);
        line-height: 1.08;
        margin: 18px 0;
      }

      .hero p {
        color: var(--muted);
        font-size: 1.08rem;
        max-width: 640px;
      }

      .hero-actions {
        display: flex;
        gap: 14px;
        margin: 28px 0;
        flex-wrap: wrap;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 14px 22px;
        border-radius: 999px;
        font-weight: 700;
        transition: 0.2s ease;
      }

      .btn-primary {
        background: var(--primary);
        color: white;
      }

      .btn-primary:hover {
        background: var(--primary-dark);
      }

      .btn-secondary {
        background: white;
        color: var(--text);
        border: 1px solid var(--border);
      }

      .hero-points {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        color: var(--muted);
        font-weight: 600;
      }

      .hero-card {
        background: linear-gradient(160deg, #e5f7eb, #fafffb);
        border: 1px solid #d9ecdf;
        border-radius: 28px;
        padding: 30px;
        min-height: 360px;
        display: grid;
        place-items: center;
        box-shadow: var(--shadow);
      }

      .hero-product {
        background: white;
        border-radius: 24px;
        padding: 28px;
        width: 100%;
        max-width: 320px;
        box-shadow: var(--shadow);
      }

      .hero-product h3 {
        margin: 16px 0 8px;
        font-size: 1.5rem;
      }

      .hero-product strong {
        font-size: 1.5rem;
        color: var(--primary-dark);
      }

      .trust {
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        background: white;
      }

      .trust-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        padding: 22px 0;
        text-align: center;
        font-weight: 700;
        color: var(--muted);
      }

      .section {
        padding: 88px 0;
      }

      .alt {
        background: #f1f7f2;
      }

      .section-head {
        max-width: 740px;
        margin-bottom: 34px;
      }

      .section-head h2 {
        font-size: clamp(1.8rem, 4vw, 2.8rem);
        margin: 12px 0 8px;
      }

      .section-head p {
        color: var(--muted);
      }

      .product-grid,
      .benefit-grid,
      .testimonial-grid,
      .contact-grid,
      .footer-grid {
        display: grid;
        gap: 24px;
      }

      .product-grid {
        grid-template-columns: repeat(3, 1fr);
      }

      .product-card,
      .benefit-card,
      .contact-card,
      .about-box,
      .testimonial-grid blockquote {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 22px;
        box-shadow: var(--shadow);
      }

      .product-image {
        height: 180px;
        border-radius: 16px;
        display: grid;
        place-items: center;
        margin-bottom: 18px;
        font-size: 2rem;
        font-weight: 800;
        color: white;
      }

      .product-card h3 {
        margin-bottom: 8px;
      }

      .product-card p {
        color: var(--muted);
        min-height: 52px;
      }

      .product-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 18px;
        gap: 14px;
      }

      .price {
        font-size: 1.2rem;
        color: var(--primary-dark);
        font-weight: 800;
      }

      .shop-btn {
        padding: 11px 16px;
        border-radius: 999px;
        background: var(--primary);
        color: white;
        font-size: 0.95rem;
        font-weight: 700;
      }

      .benefit-grid,
      .contact-grid,
      .testimonial-grid {
        grid-template-columns: repeat(3, 1fr);
      }

      .about-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 30px;
        align-items: start;
      }

      .about-box h3 {
        margin-top: 0;
        margin-bottom: 12px;
      }

      .about-box ul {
        padding-left: 18px;
        margin: 0;
      }

      .newsletter-box {
        background: linear-gradient(140deg, #214d34, #2f7d4f);
        color: white;
        border-radius: 28px;
        padding: 38px;
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 28px;
        align-items: center;
      }

      .newsletter-form {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
      }

      .newsletter-form input {
        flex: 1;
        min-width: 220px;
        border: none;
        padding: 15px 18px;
        border-radius: 999px;
        font: inherit;
      }

      .contact-card h3 {
        margin-top: 0;
        margin-bottom: 8px;
      }

      footer {
        background: #15201a;
        color: #d9e5dc;
        padding-top: 52px;
      }

      .footer-grid {
        grid-template-columns: 2fr 1fr 1fr;
        padding-bottom: 32px;
      }

      footer h3,
      footer h4 {
        color: white;
        margin-bottom: 10px;
      }

      footer a {
        display: block;
        margin-bottom: 8px;
        color: #d9e5dc;
      }

      .copyright {
        text-align: center;
        border-top: 1px solid rgba(255,255,255,0.08);
        padding: 18px;
        color: #afbeb3;
      }

      @media (max-width: 980px) {
        .hero-grid,
        .about-grid,
        .newsletter-box,
        .product-grid,
        .benefit-grid,
        .testimonial-grid,
        .contact-grid,
        .footer-grid,
        .trust-grid {
          grid-template-columns: 1fr;
        }

        .menu {
          display: none;
        }

        .hero {
          padding-top: 48px;
        }
      }

      @media (max-width: 640px) {
        .hero h1 {
          font-size: 2.2rem;
        }

        .hero-actions {
          flex-direction: column;
        }

        .btn,
        .nav-cta,
        .shop-btn {
          width: 100%;
          text-align: center;
        }
      }
    </style>
  </head>

  <body>
    <header class="topbar">
      <div class="container nav">
        <a href="/" class="logo">
          <span class="logo-mark">A</span>
          <span>Amic Biotech</span>
        </a>

        <nav class="menu">
          <a href="#produkter">Produkter</a>
          <a href="#fordeler">Fordeler</a>
          <a href="#om-oss">Om oss</a>
          <a href="#kontakt">Kontakt</a>
        </nav>

        <a href="#produkter" class="nav-cta">Kjøp nå</a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container hero-grid">
          <div>
            <span class="badge">Norsk vitaminbutikk</span>
            <h1>Vitaminer fra Amic Biotech for energi, balanse og velvære</h1>
            <p>
              Oppdag nøye utvalgte vitaminer og kosttilskudd utviklet for en aktiv hverdag.
              Enkle produkter, tydelige fordeler og høy kvalitet.
            </p>

            <div class="hero-actions">
              <a href="#produkter" class="btn btn-primary">Se produkter</a>
              <a href="#om-oss" class="btn btn-secondary">Les mer</a>
            </div>

            <div class="hero-points">
              <span>Høy kvalitet</span>
              <span>Rask levering</span>
              <span>Trygg betaling</span>
            </div>
          </div>

          <div class="hero-card">
            <div class="hero-product">
              <div class="pill">Bestselger</div>
              <h3>Vitamin D3 + K2</h3>
              <p>Støtter immunforsvar, skjelett og daglig balanse.</p>
              <strong>249 kr</strong>
            </div>
          </div>
        </div>
      </section>

      <section class="trust">
        <div class="container trust-grid">
          <div>Naturlig inspirerte ingredienser</div>
          <div>Utviklet for daglig bruk</div>
          <div>Norsk språk og kundestøtte</div>
        </div>
      </section>

      <section id="produkter" class="section">
        <div class="container">
          <div class="section-head">
            <span class="section-tag">Produkter</span>
            <h2>Populære vitaminer</h2>
            <p>
              Et sterkt utvalg av daglige favoritter for immunforsvar, energi og fokus.
            </p>
          </div>

          <div class="product-grid">
            {products.map((product) => (
              <article class="product-card">
                <div class="product-image" style={`background:${product.color}`}>
                  {product.badge}
                </div>
                <h3>{product.name}</h3>
                <p>{product.description}</p>
                <div class="product-meta">
                  <span class="price">{product.price}</span>
                  <a href="#kontakt" class="shop-btn">Bestill nå</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="fordeler" class="section alt">
        <div class="container">
          <div class="section-head">
            <span class="section-tag">Hvorfor velge oss</span>
            <h2>Enklere helsevalg med Amic Biotech</h2>
          </div>

          <div class="benefit-grid">
            <div class="benefit-card">
              <h3>Kvalitet først</h3>
              <p>Vi fokuserer på produkter som passer moderne behov og daglig bruk.</p>
            </div>
            <div class="benefit-card">
              <h3>Tydelig informasjon</h3>
              <p>Enkle beskrivelser som gjør det lettere å velge riktig vitamin.</p>
            </div>
            <div class="benefit-card">
              <h3>For hele familien</h3>
              <p>Sortiment som passer både aktive voksne og familier i en travel hverdag.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section-head">
            <span class="section-tag">Kundeopplevelser</span>
            <h2>Hva kundene sier</h2>
          </div>

          <div class="testimonial-grid">
            <blockquote>
              “Rask levering og produkter som er enkle å forstå. Kommer til å bestille igjen.”
              <footer>– Ingrid, Oslo</footer>
            </blockquote>
            <blockquote>
              “Vitamin D3 og magnesium har blitt fast del av rutinen min.”
              <footer>– Martin, Bergen</footer>
            </blockquote>
            <blockquote>
              “Flott design, enkel bestilling og god oversikt over produktene.”
              <footer>– Sara, Trondheim</footer>
            </blockquote>
          </div>
        </div>
      </section>

      <section id="om-oss" class="section alt">
        <div class="container about-grid">
          <div>
            <span class="section-tag">Om oss</span>
            <h2>Amic Biotech</h2>
            <p>
              Amic Biotech er et merke for deg som ønsker kvalitetsvitaminer med et rent,
              moderne og tillitsvekkende uttrykk. Målet vårt er å gjøre helseprodukter lettere
              å forstå og enklere å bruke i hverdagen.
            </p>
            <p>
              Vi tror på tydelig kommunikasjon, høy kvalitet og produkter som passer ekte behov.
            </p>
          </div>

          <div class="about-box">
            <h3>Vårt løfte</h3>
            <ul>
              <li>Kvalitetsfokus</li>
              <li>Trygg handel</li>
              <li>Moderne kundereise</li>
              <li>Norsk innhold</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container newsletter-box">
          <div>
            <span class="section-tag" style="background: rgba(255,255,255,0.16); color: white;">
              Nyhetsbrev
            </span>
            <h2>Få tilbud og helsetips først</h2>
            <p>Meld deg på for produktnyheter, kampanjer og nyttig inspirasjon.</p>
          </div>

          <form class="newsletter-form">
            <input type="email" placeholder="Din e-postadresse" />
            <a href="#kontakt" class="btn btn-secondary">Meld meg på</a>
          </form>
        </div>
      </section>

      <section id="kontakt" class="section">
        <div class="container">
          <div class="section-head">
            <span class="section-tag">Kontakt</span>
            <h2>Vi hjelper deg gjerne</h2>
            <p>Har du spørsmål om produkter, levering eller bestilling? Ta kontakt.</p>
          </div>

          <div class="contact-grid">
            <div class="contact-card">
              <h3>E-post</h3>
              <p>kontakt@amicbridge.com</p>
            </div>
            <div class="contact-card">
              <h3>Telefon</h3>
              <p>+47 00 00 00 00</p>
            </div>
            <div class="contact-card">
              <h3>Adresse</h3>
              <p>Oslo, Norge</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-grid">
        <div>
          <h3>Amic Biotech</h3>
          <p>Vitaminer og kosttilskudd for en bedre hverdag.</p>
        </div>
        <div>
          <h4>Hurtiglenker</h4>
          <a href="#produkter">Produkter</a>
          <a href="#om-oss">Om oss</a>
          <a href="#kontakt">Kontakt</a>
        </div>
        <div>
          <h4>Informasjon</h4>
          <a href="#">Kjøpsvilkår</a>
          <a href="#">Personvern</a>
          <a href="#">Retur og levering</a>
        </div>
      </div>

      <div class="copyright">
        © 2026 Amic Biotech. Alle rettigheter reservert.
      </div>
    </footer>
  </body>
</html>
