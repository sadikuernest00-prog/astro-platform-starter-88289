---
const products = [
  { name: "Vitamin D3 + K2", price: "249 kr" },
  { name: "Vitamin C 1000", price: "199 kr" },
  { name: "Magnesium", price: "239 kr" },
  { name: "Multivitamin", price: "289 kr" }
];
---

<html lang="no">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Amic Biotech</title>
    <meta
      name="Vitaminer for daglig bruk."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Cormorant+Garamond:wght@500;600&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --bg: #f5f1ea;
        --surface: #fbf8f3;
        --surface-2: #efe7dc;
        --line: #ddd3c6;
        --text: #1f1c18;
        --muted: #6e675f;
        --dark: #171411;
        --white: #ffffff;
        --shadow: 0 14px 32px rgba(25, 20, 14, 0.05);
        --radius-xl: 34px;
        --radius-lg: 24px;
        --radius-md: 18px;
        --container: 1200px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: "Inter", sans-serif;
        line-height: 1.5;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .container {
        width: min(100% - 32px, var(--container));
        margin: 0 auto;
      }

      .serif {
        font-family: "Cormorant Garamond", serif;
      }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgba(245, 241, 234, 0.9);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(221, 211, 198, 0.7);
      }

      .nav {
        min-height: 82px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 600;
        letter-spacing: 0.01em;
      }

      .brand-mark {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: #b7a28e;
        color: white;
        font-weight: 700;
      }

      .menu {
        display: flex;
        gap: 28px;
        color: var(--muted);
        font-size: 0.95rem;
      }

      .menu a:hover {
        color: var(--text);
      }

      .nav-btn {
        padding: 12px 20px;
        border-radius: 999px;
        background: var(--dark);
        color: white;
        font-weight: 600;
      }

      .hero {
        padding: 72px 0 40px;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 26px;
        align-items: stretch;
      }

      .hero-copy,
      .hero-visual {
        border-radius: var(--radius-xl);
        overflow: hidden;
      }

      .hero-copy {
        background: var(--surface);
        border: 1px solid var(--line);
        padding: 56px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 620px;
      }

      .eyebrow {
        display: inline-block;
        margin-bottom: 16px;
        font-size: 0.78rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
      }

      h1 {
        margin: 0 0 18px;
        font-size: clamp(3.2rem, 7vw, 6rem);
        line-height: 0.92;
        font-weight: 600;
        letter-spacing: -0.03em;
      }

      .hero-copy p {
        margin: 0;
        max-width: 470px;
        color: var(--muted);
        font-size: 1.02rem;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 14px 22px;
        border-radius: 999px;
        font-weight: 600;
      }

      .btn-primary {
        background: var(--dark);
        color: white;
      }

      .btn-secondary {
        background: transparent;
        border: 1px solid var(--line);
      }

      .hero-visual {
        position: relative;
        min-height: 620px;
        background:
          radial-gradient(circle at top left, rgba(255,255,255,0.4), transparent 30%),
          linear-gradient(135deg, #ddd0c0 0%, #c0ad99 48%, #8f7b68 100%);
      }

      .hero-bottle {
        position: absolute;
        right: 58px;
        top: 92px;
        width: 190px;
        height: 360px;
        border-radius: 90px 90px 40px 40px;
        background: linear-gradient(180deg, #faf7f2, #eee6da 70%, #e3d6c6);
        box-shadow: 0 20px 35px rgba(40, 30, 20, 0.12);
      }

      .hero-cap {
        position: absolute;
        right: 102px;
        top: 52px;
        width: 102px;
        height: 64px;
        border-radius: 20px 20px 12px 12px;
        background: #ede5da;
        box-shadow: 0 8px 20px rgba(40, 30, 20, 0.08);
      }

      .hero-label {
        position: absolute;
        right: 78px;
        top: 178px;
        width: 150px;
        padding: 24px 18px;
        border-radius: 20px;
        background: rgba(255,255,255,0.72);
        backdrop-filter: blur(10px);
        text-align: center;
        border: 1px solid rgba(255,255,255,0.8);
      }

      .hero-label small {
        display: block;
        color: var(--muted);
        margin-bottom: 8px;
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .hero-label strong {
        display: block;
        font-size: 1.1rem;
      }

      .section {
        padding: 34px 0 96px;
      }

      .section-head {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 20px;
        margin-bottom: 24px;
      }

      .section-head h2 {
        margin: 0;
        font-size: clamp(2rem, 5vw, 3.6rem);
        line-height: 1;
        font-weight: 600;
      }

      .section-head p {
        margin: 0;
        color: var(--muted);
        max-width: 320px;
      }

      .products-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
      }

      .product-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: var(--shadow);
      }

      .product-image {
        height: 320px;
        background:
          radial-gradient(circle at top left, rgba(255,255,255,0.45), transparent 30%),
          linear-gradient(135deg, #d8c9b9 0%, #bca690 55%, #8b7764 100%);
      }

      .product-body {
        padding: 20px;
      }

      .product-body h3 {
        margin: 0 0 8px;
        font-size: 1.05rem;
        font-weight: 600;
      }

      .product-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: var(--muted);
        font-size: 0.95rem;
      }

      .product-row strong {
        color: var(--text);
      }

      .about {
        padding-bottom: 96px;
      }

      .about-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
      }

      .about-card,
      .contact-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius-xl);
        padding: 42px;
        box-shadow: var(--shadow);
      }

      .about-card h2,
      .contact-card h2 {
        margin: 0 0 12px;
        font-size: clamp(2rem, 4vw, 3.2rem);
        line-height: 1;
        font-weight: 600;
      }

      .about-card p,
      .contact-card p {
        margin: 0;
        max-width: 460px;
        color: var(--muted);
      }

      .mini-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        margin-top: 26px;
      }

      .mini-box {
        background: var(--surface-2);
        border-radius: 18px;
        padding: 18px;
      }

      .mini-box strong {
        display: block;
        margin-bottom: 4px;
        font-size: 0.98rem;
      }

      .mini-box span {
        color: var(--muted);
        font-size: 0.92rem;
      }

      .contact-list {
        display: grid;
        gap: 14px;
        margin-top: 26px;
      }

      .contact-item {
        padding: 16px 18px;
        border: 1px solid var(--line);
        border-radius: 16px;
        background: #f7f2eb;
      }

      .contact-item strong {
        display: block;
        margin-bottom: 4px;
        font-size: 0.95rem;
      }

      .contact-item span {
        color: var(--muted);
        font-size: 0.95rem;
      }

      footer {
        padding: 0 0 36px;
      }

      .footer-row {
        border-top: 1px solid var(--line);
        padding-top: 20px;
        display: flex;
        justify-content: space-between;
        gap: 20px;
        color: var(--muted);
        font-size: 0.94rem;
      }

      @media (max-width: 1100px) {
        .products-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .hero-grid,
        .about-grid {
          grid-template-columns: 1fr;
        }

        .hero-copy,
        .hero-visual {
          min-height: 520px;
        }
      }

      @media (max-width: 820px) {
        .menu {
          display: none;
        }

        .hero-copy {
          padding: 32px;
        }

        .products-grid,
        .mini-grid,
        .footer-row {
          grid-template-columns: 1fr;
          display: grid;
        }

        .about-card,
        .contact-card {
          padding: 28px;
        }
      }

      @media (max-width: 640px) {
        .hero {
          padding-top: 36px;
        }

        h1 {
          font-size: 2.9rem;
        }

        .hero-actions {
          flex-direction: column;
        }

        .btn,
        .nav-btn {
          width: 100%;
        }

        .section-head {
          display: block;
        }

        .section-head p {
          margin-top: 10px;
        }

        .hero-bottle {
          right: 50%;
          transform: translateX(50%);
          top: 86px;
          width: 150px;
          height: 300px;
        }

        .hero-cap {
          right: 50%;
          transform: translateX(50%);
          top: 50px;
          width: 84px;
          height: 54px;
        }

        .hero-label {
          right: 50%;
          transform: translateX(50%);
          top: 170px;
          width: 130px;
        }
      }
    </style>
  </head>

  <body>
    <header class="topbar">
      <div class="container nav">
        <a href="/" class="brand">
          <span class="brand-mark">A</span>
          <span>Amic Biotech</span>
        </a>

        <nav class="menu">
          <a href="#produkter">Produkter</a>
          <a href="#om">Om oss</a>
          <a href="#kontakt">Kontakt</a>
        </nav>

        <a href="#produkter" class="nav-btn">Se produkter</a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container hero-grid">
          <div class="hero-copy">
            <span class="eyebrow">Amic Biotech</span>
            <h1 class="serif">Vitaminer i et rent, skandinavisk uttrykk.</h1>
            <p>
              Moderne kosttilskudd presentert enkelt, nøytralt og tydelig.
            </p>

            <div class="hero-actions">
              <a href="#produkter" class="btn btn-primary">Utforsk sortimentet</a>
              <a href="#kontakt" class="btn btn-secondary">Kontakt oss</a>
            </div>
          </div>

          <div class="hero-visual">
            <div class="hero-cap"></div>
            <div class="hero-bottle"></div>
            <div class="hero-label">
              <small>Vitamin</small>
              <strong>D3 + K2</strong>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="produkter">
        <div class="container">
          <div class="section-head">
            <h2 class="serif">Utvalgte produkter</h2>
            <p>Et enkelt og gjennomført utvalg for daglig bruk.</p>
          </div>

          <div class="products-grid">
            {products.map((product) => (
              <article class="product-card">
                <div class="product-image"></div>
                <div class="product-body">
                  <h3>{product.name}</h3>
                  <div class="product-row">
                    <span>Daglig tilskudd</span>
                    <strong>{product.price}</strong>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="about" id="om">
        <div class="container about-grid">
          <article class="about-card">
            <h2 class="serif">En roligere måte å presentere vitaminer på.</h2>
            <p>
              Amic Biotech kombinerer et nøytralt uttrykk med moderne produkter for hverdagen.
            </p>

            <div class="mini-grid">
              <div class="mini-box">
                <strong>Rent uttrykk</strong>
                <span>Nøytral og moderne profil</span>
              </div>
              <div class="mini-box">
                <strong>Daglig bruk</strong>
                <span>Enkle produkter for rutiner</span>
              </div>
              <div class="mini-box">
                <strong>Norsk merkevare</strong>
                <span>Tydelig og rolig presentasjon</span>
              </div>
              <div class="mini-box">
                <strong>Premium følelse</strong>
                <span>Diskré og gjennomført design</span>
              </div>
            </div>
          </article>

          <article class="contact-card" id="kontakt">
            <h2 class="serif">Kontakt</h2>
            <p>Ta kontakt for spørsmål om produkter, bestilling eller samarbeid.</p>

            <div class="contact-list">
              <div class="contact-item">
                <strong>E-post</strong>
                <span>kontakt@amicbridge.com</span>
              </div>
              <div class="contact-item">
                <strong>Telefon</strong>
                <span>+47 00 00 00 00</span>
              </div>
              <div class="contact-item">
                <strong>Adresse</strong>
                <span>Oslo, Norge</span>
              </div>
            </div>
          </article>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-row">
        <div>© 2026 Amic Biotech</div>
        <div>Vitaminer og kosttilskudd</div>
      </div>
    </footer>
  </body>
</html>
