
<!DOCTYPE html>
<html lang="no">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Amic Biotech</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f7faf8;
      color: #1c2b24;
      line-height: 1.5;
    }

    header {
      background: #0f5132;
      color: white;
      padding: 20px 8%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
    }

    header h1 {
      font-size: 24px;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 20px;
      font-size: 14px;
    }

    .hero {
      min-height: 85vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      padding: 60px 8%;
      gap: 40px;
    }

    .hero h2 {
      font-size: 52px;
      margin-bottom: 16px;
    }

    .hero p {
      font-size: 18px;
      color: #4a5c53;
      margin-bottom: 24px;
      max-width: 500px;
    }

    .btn {
      display: inline-block;
      background: #16a34a;
      color: white;
      text-decoration: none;
      padding: 14px 24px;
      border-radius: 10px;
      font-weight: bold;
    }

    .hero-card {
      background: white;
      border-radius: 20px;
      padding: 30px;
      box-shadow: 0 15px 40px rgba(0,0,0,0.08);
    }

    .hero-card img {
      width: 100%;
      border-radius: 16px;
      margin-bottom: 20px;
    }

    .section {
      padding: 70px 8%;
    }

    .section h3 {
      font-size: 32px;
      margin-bottom: 30px;
      text-align: center;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 24px;
    }

    .product {
      background: white;
      border-radius: 18px;
      padding: 24px;
      text-align: center;
      box-shadow: 0 10px 30px rgba(0,0,0,0.06);
    }

    .product .icon {
      font-size: 48px;
      margin-bottom: 12px;
    }

    .product h4 {
      margin-bottom: 8px;
      font-size: 20px;
    }

    .product p {
      color: #5d6b64;
      font-size: 14px;
      margin-bottom: 12px;
    }

    .price {
      font-size: 22px;
      font-weight: bold;
      color: #0f5132;
      margin-bottom: 14px;
    }

    .product button {
      background: #0f5132;
      color: white;
      border: none;
      padding: 12px 18px;
      border-radius: 10px;
      cursor: pointer;
    }

    .about {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
      align-items: center;
    }

    .about-box {
      background: white;
      padding: 30px;
      border-radius: 18px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.06);
    }

    .contact {
      text-align: center;
      background: #e8f5ec;
      border-radius: 20px;
      padding: 40px 20px;
    }

    .contact p {
      margin: 10px 0;
    }

    footer {
      text-align: center;
      padding: 24px;
      font-size: 14px;
      color: #5d6b64;
    }

    @media (max-width: 900px) {
      .hero,
      .about {
        grid-template-columns: 1fr;
      }

      .hero h2 {
        font-size: 38px;
      }

      header {
        flex-direction: column;
        gap: 10px;
      }

      nav a {
        margin: 0 10px;
      }
    }
  </style>
</head>
<body>

  <header>
    <h1>Amic Biotech</h1>
    <nav>
      <a href="#produkter">Produkter</a>
      <a href="#omoss">Om oss</a>
      <a href="#kontakt">Kontakt</a>
    </nav>
  </header>

  <section class="hero">
    <div>
      <h2>Premium vitaminer for hver dag</h2>
      <p>Enkle produkter. Ren kvalitet. Bedre helse.</p>
      <a href="#produkter" class="btn">Kjøp nå</a>
    </div>

    <div class="hero-card">
      <img src="https://images.unsplash.com/photo-1607619056574-7b8d3ee536b2?auto=format&fit=crop&w=900&q=80" alt="Vitaminer">
      <h3>Naturlig støtte</h3>
      <p>Vitamin C, D3 og Multivitamin laget for daglig bruk.</p>
    </div>
  </section>

  <section class="section" id="produkter">
    <h3>Våre vitaminer</h3>
    <div class="products">
      <div class="product">
        <div class="icon">🍊</div>
        <h4>Vitamin C</h4>
        <p>Daglig støtte for immunforsvar.</p>
        <div class="price">199 kr</div>
        <button onclick="buyProduct('Vitamin C')">Kjøp</button>
      </div>

      <div class="product">
        <div class="icon">☀️</div>
        <h4>Vitamin D3</h4>
        <p>For energi og velvære.</p>
        <div class="price">229 kr</div>
        <button onclick="buyProduct('Vitamin D3')">Kjøp</button>
      </div>

      <div class="product">
        <div class="icon">💊</div>
        <h4>Multivitamin</h4>
        <p>Alt-i-ett for hverdagen.</p>
        <div class="price">249 kr</div>
        <button onclick="buyProduct('Multivitamin')">Kjøp</button>
      </div>
    </div>
  </section>

  <section class="section" id="omoss">
    <div class="about">
      <div class="about-box">
        <h3>Om Amic Biotech</h3>
        <p>Vi selger moderne vitaminer med enkelt fokus: kvalitet, trygghet og daglig helse.</p>
      </div>
      <div class="about-box">
        <h3>Hvorfor velge oss</h3>
        <p>Rene produkter, enkel bestilling og rask levering.</p>
      </div>
    </div>
  </section>

  <section class="section" id="kontakt">
    <div class="contact">
      <h3>Kontakt</h3>
      <p>E-post: contact@amicbiotech.com</p>
      <p>Telefon: +47 99 99 99 99</p>
      <p>Oslo, Norge</p>
    </div>
  </section>

  <footer>
    © 2026 Amic Biotech. Alle rettigheter reservert.
  </footer>

  <script>
    function buyProduct(productName) {
      alert("Du valgte: " + productName);
    }
  </script>

</body>
</html>
