---
const title = "AmicBridge Academy";
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{title}</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{
background:#f5f7fb;
color:#222;
}

header{
background:#071c39;
color:white;
padding:18px 8%;
display:flex;
justify-content:space-between;
align-items:center;
}

header h1{
font-size:28px;
}

nav a{
color:white;
text-decoration:none;
margin-left:20px;
}

.hero{
padding:100px 8%;
display:grid;
grid-template-columns:1fr 1fr;
align-items:center;
gap:40px;
}

.hero h2{
font-size:50px;
margin-bottom:20px;
color:#071c39;
}

.hero p{
font-size:18px;
line-height:1.7;
margin-bottom:30px;
}

.btn{
display:inline-block;
background:#0066ff;
padding:15px 35px;
color:white;
text-decoration:none;
border-radius:8px;
}

.image img{
width:100%;
border-radius:15px;
}

.section{
padding:80px 8%;
}

.cards{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:25px;
}

.card{
background:white;
padding:30px;
border-radius:12px;
box-shadow:0 10px 25px rgba(0,0,0,.08);
}

.card h3{
margin-bottom:15px;
}

footer{
background:#071c39;
color:white;
text-align:center;
padding:30px;
margin-top:80px;
}

@media(max-width:900px){

.hero{
grid-template-columns:1fr;
text-align:center;
}

.cards{
grid-template-columns:1fr;
}

}
</style>

</head>

<body>

<header>

<h1>AmicBridge</h1>

<nav>
<a href="#">Home</a>
<a href="#">Courses</a>
<a href="#">Pricing</a>
<a href="#">Contact</a>
</nav>

</header>

<section class="hero">

<div>

<h2>Learn Smart Investing</h2>

<p>
Private online investment courses designed to help beginners
understand investing through structured lessons, practical examples,
and risk-aware strategies.
</p>

<a href="#" class="btn">Join Now</a>

</div>

<div class="image">

<img
src="https://images.unsplash.com/photo-1559526324-593bc073d938?w=800"
alt="Investment"
/>

</div>

</section>

<section class="section">

<h2 style="text-align:center;margin-bottom:50px;">
Our Courses
</h2>

<div class="cards">

<div class="card">
<h3>Investment Basics</h3>
<p>
Understand stocks, ETFs, diversification, and investment fundamentals.
</p>
</div>

<div class="card">
<h3>Risk Management</h3>
<p>
Learn how to evaluate risk and build a balanced portfolio.
</p>
</div>

<div class="card">
<h3>Market Analysis</h3>
<p>
Explore technical and fundamental analysis concepts for educational purposes.
</p>
</div>

</div>

</section>

<footer>

<p>
© 2026 AmicBridge Academy. Educational content only. Investing involves risk.
</p>

</footer>

</body>
</html>
