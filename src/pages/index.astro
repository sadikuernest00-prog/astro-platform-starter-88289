---
const products = [
  { name: "Vitamin D3 + K2", price: "249 kr" },
  { name: "Vitamin C 1000", price: "199 kr" },
  { name: "Magnesium", price: "239 kr" },
  { name: "Multivitamin", price: "289 kr" }
];
---

<html lang="no">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Amic Biotech</title>
    <meta
      name="description"
      content="Amic Biotech tilbyr vitaminer og kosttilskudd i et rent og moderne uttrykk."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Cormorant+Garamond:wght@500;600&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --bg: #f6f4f0;
        --surface: #fcfbf8;
        --line: #ddd6cd;
        --text: #1f1d1a;
        --muted: #6f685f;
        --accent: #8b7761;
        --accent-dark: #6d5c4c;
        --white: #ffffff;
        --shadow: 0 14px 30px rgba(28, 24, 19, 0.05);
        --radius-lg: 28px;
        --radius-md: 18px;
        --container: 1160px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: "Inter", sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.5;
      }

      a {
        text-decoration: none;
        color: inherit;
      }

      .container {
        width: min(100% - 32px, var(--container));
        margin: 0 auto;
      }

      .serif {
        font-family: "Cormorant Garamond", serif;
      }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgba(246, 244, 240, 0.92);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(221, 214, 205, 0.8);
      }

      .nav {
        min-height: 78px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 600;
      }

      .brand-mark {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        color: white;
        background: linear-gradient(135deg, #b49d86, #87715d);
      }

      .menu {
        display: flex;
        gap: 28px;
        color: var(--muted);
        font-size: 0.95rem;
      }

      .menu a:hover {
        color: var(--text);
      }

      .nav-btn {
        padding: 12px 18px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: var(--white);
        font-weight: 600;
      }

      .hero {
        padding: 92px 0 64px;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 40px;
        align-items: center;
      }

      .eyebrow {
        display: inline-block;
        margin-bottom: 14px;
        font-size: 0.78rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--accent-dark);
      }

      h1 {
        margin: 0 0 18px;
        font-size: clamp(3rem, 6vw, 5.2rem);
        line-height: 0.95;
        font-weight: 600;
        letter-spacing: -0.02em;
      }

      .hero p {
        margin: 0 0 26px;
        max-width: 520px;
        color: var(--muted);
        font-size: 1.02rem;
      }

      .hero-actions {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 14px 22px;
        border-radius: 999px;
        font-weight: 600;
      }

      .btn-primary {
        background: var(--text);
        color: white;
      }

      .btn-secondary {
        border: 1px solid var(--line);
        background: transparent;
      }

      .hero-card {
        background: linear-gradient(135deg, #e6ddd2, #c8b6a5 55%, #8a7662);
        min-height: 500px;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow);
        position: relative;
        overflow: hidden;
      }

      .hero-card::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
          radial-gradient(circle at top left, rgba(255,255,255,0.45), transparent 30%),
          linear-gradient(rgba(255,255,255,0.08), rgba(255,255,255,0.08));
      }

      .hero-panel {
        position: absolute;
        left: 24px;
        right: 24px;
        bottom: 24px;
        background: rgba(255, 255, 255, 0.84);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.8);
        border-radius: 18px;
        padding: 20px;
      }

      .hero-panel small {
        display: block;
        color: var(--muted);
        margin-bottom: 8px;
      }

      .hero-panel h3 {
        margin: 0 0 6px;
        font-size: 1.2rem;
      }

      .hero-panel strong {
        font-size: 1rem;
      }

      .section {
        padding: 84px 0;
      }

      .section-head {
        margin-bottom: 28px;
      }

      .section-head h2 {
        margin: 0;
        font-size: clamp(2.2rem, 5vw, 3.8rem);
        line-height: 1;
        font-weight: 600;
      }

      .products-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 22px;
      }

      .product-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius-md);
        overflow: hidden;
        box-shadow: var(--shadow);
      }

      .product-image {
        height: 220px;
        background:
          radial-gradient(circle at top left, rgba(255,255,255,0.5), transparent 35%),
          linear-gradient(135deg, #d8cdc0, #b39f8a 55%, #85715f);
      }

      .product-body {
        padding: 20px;
      }

      .product-body h3 {
        margin: 0 0 8px;
        font-size: 1.05rem;
      }

      .product-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        color: var(--muted);
      }

      .product-row strong {
        color: var(--text);
        font-size: 1rem;
      }

      .about-box {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        padding: 36px;
        box-shadow: var(--shadow);
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        align-items: center;
      }

      .about-box h2 {
        margin: 0 0 10px;
        font-size: clamp(2rem, 4vw, 3.3rem);
        line-height: 1;
        font-weight: 600;
      }

      .about-box p {
        margin: 0;
        color: var(--muted);
        max-width: 460px;
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
      }

      .stat {
        padding: 22px;
        border: 1px solid var(--line);
        border-radius: 18px;
        background: #f5f0ea;
      }

      .stat strong {
        display: block;
        margin-bottom: 6px;
        font-size: 1.05rem;
      }

      .stat span {
        color: var(--muted);
        font-size: 0.95rem;
      }

      .contact {
        background: #eee7de;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .contact-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 22px;
      }

      .contact-card {
        background: rgba(255,255,255,0.5);
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 22px;
      }

      .contact-card h3 {
        margin: 0 0 8px;
        font-size: 1rem;
      }

      .contact-card p {
        margin: 0;
        color: var(--muted);
      }

      footer {
        padding: 28px 0 40px;
      }

      .footer-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        color: var(--muted);
        font-size: 0.94rem;
      }

      @media (max-width: 1024px) {
        .hero-grid,
        .about-box,
        .products-grid,
        .contact-grid,
        .stats {
          grid-template-columns: 1fr 1fr;
        }
      }

      @media (max-width: 820px) {
        .hero-grid,
        .about-box,
        .products-grid,
        .contact-grid,
        .stats,
        .footer-row {
          grid-template-columns: 1fr;
          display: grid;
        }

        .menu {
          display: none;
        }

        .hero-card {
          min-height: 360px;
        }
      }

      @media (max-width: 640px) {
        .hero {
          padding-top: 56px;
        }

        .hero-actions {
          flex-direction: column;
        }

        .btn,
        .nav-btn {
          width: 100%;
        }

        h1 {
          font-size: 2.8rem;
        }

        .about-box {
          padding: 24px;
        }
      }
    </style>
  </head>

  <body>
    <header class="topbar">
      <div class="container nav">
        <a href="/" class="brand">
          <span class="brand-mark">A</span>
          <span>Amic Biotech</span>
        </a>

        <nav class="menu">
          <a href="#produkter">Produkter</a>
          <a href="#om">Om oss</a>
          <a href="#kontakt">Kontakt</a>
        </nav>

        <a href="#produkter" class="nav-btn">Se sortiment</a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container hero-grid">
          <div>
            <span class="eyebrow">Amic Biotech</span>
            <h1 class="serif">Vitaminer i et rent og moderne uttrykk.</h1>
            <p>
              Et nøytralt og gjennomført univers for daglige vitaminer og kosttilskudd.
            </p>

            <div class="hero-actions">
              <a href="#produkter" class="btn btn-primary">Se produkter</a>
              <a href="#kontakt" class="btn btn-secondary">Kontakt</a>
            </div>
          </div>

          <div class="hero-card">
            <div class="hero-panel">
              <small>Utvalgt produkt</small>
              <h3>Vitamin D3 + K2</h3>
              <strong>249 kr</strong>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="produkter">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Produkter</span>
            <h2 class="serif">Utvalgte vitaminer</h2>
          </div>

          <div class="products-grid">
            {products.map((product) => (
              <article class="product-card">
                <div class="product-image"></div>
                <div class="product-body">
                  <h3>{product.name}</h3>
                  <div class="product-row">
                    <span>Daglig tilskudd</span>
                    <strong>{product.price}</strong>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="om">
        <div class="container">
          <div class="about-box">
            <div>
              <span class="eyebrow">Om Amic Biotech</span>
              <h2 class="serif">En enklere tilnærming til vitaminer.</h2>
              <p>
                Amic Biotech tilbyr vitaminer og kosttilskudd i et rolig, nøytralt og eksklusivt uttrykk.
              </p>
            </div>

            <div class="stats">
              <div class="stat">
                <strong>Rent uttrykk</strong>
                <span>Moderne og nøytral profil</span>
              </div>
              <div class="stat">
                <strong>Daglige produkter</strong>
                <span>Enkle valg for hverdagen</span>
              </div>
              <div class="stat">
                <strong>Norsk merkevare</strong>
                <span>Tydelig og tillitsfull presentasjon</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section contact" id="kontakt">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Kontakt</span>
            <h2 class="serif">Ta kontakt</h2>
          </div>

          <div class="contact-grid">
            <article class="contact-card">
              <h3>E-post</h3>
              <p>kontakt@amicbridge.com</p>
            </article>

            <article class="contact-card">
              <h3>Telefon</h3>
              <p>+47 00 00 00 00</p>
            </article>

            <article class="contact-card">
              <h3>Adresse</h3>
              <p>Oslo, Norge</p>
            </article>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-row">
        <div>© 2026 Amic Biotech</div>
        <div>Vitaminer og kosttilskudd</div>
      </div>
    </footer>
  </body>
</html>
